{
  "name": "Orbit",
  "short_name": "Orbit",
  "description": "Free, private tools for PDFs, photos, video, audio and documents. Everything runs on your device, so your files never leave it.",
  "icons": [
    {
      "src": "/assets/meta/web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/meta/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/meta/web-app-manifest-maskable-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/assets/meta/web-app-manifest-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/assets/meta/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "theme_color": "#047857",
  "background_color": "#ffffff",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "scope": "/",
  "start_url": "/?source=pwa",
  "id": "com.nexonauts.orbit",
  "dir": "auto",
  "lang": "en",
  "orientation": "any",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "handle_links": "preferred",
  "prefer_related_applications": false,
  "categories": [
    "business",
    "education",
    "productivity",
    "utilities"
  ],
  "shortcuts": [
    {
      "name": "Merge PDF",
      "short_name": "Merge",
      "description": "Combine multiple PDFs into one",
      "url": "/tools/merge-pdf?source=pwa-shortcut",
      "icons": [
        {
          "src": "/assets/meta/web-app-manifest-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Split PDF",
      "short_name": "Split",
      "description": "Split a PDF into separate files",
      "url": "/tools/split-pdf?source=pwa-shortcut",
      "icons": [
        {
          "src": "/assets/meta/web-app-manifest-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Compress PDF",
      "short_name": "Compress",
      "description": "Reduce PDF file size",
      "url": "/tools/compress-pdf?source=pwa-shortcut",
      "icons": [
        {
          "src": "/assets/meta/web-app-manifest-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Photo and Signature for Forms",
      "short_name": "Form photo",
      "description": "Resize a photo to an exact size and KB limit",
      "url": "/tools/photo-for-forms?source=pwa-shortcut",
      "icons": [
        {
          "src": "/assets/meta/web-app-manifest-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Compress Image",
      "short_name": "Compress image",
      "description": "Shrink a photo to a target size",
      "url": "/tools/image-compress?source=pwa-shortcut",
      "icons": [
        {
          "src": "/assets/meta/web-app-manifest-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Video Converter",
      "short_name": "Video",
      "description": "Convert or compress a video",
      "url": "/tools/video-converter?source=pwa-shortcut",
      "icons": [
        {
          "src": "/assets/meta/web-app-manifest-192x192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": [
            "application/pdf",
            "image/*",
            "video/*",
            "audio/*"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/open",
      "accept": {
        "application/pdf": [
          ".pdf"
        ],
        "image/*": [
          ".jpg",
          ".jpeg",
          ".png",
          ".webp",
          ".heic",
          ".avif"
        ],
        "video/*": [
          ".mp4",
          ".mov",
          ".mkv",
          ".webm"
        ],
        "audio/*": [
          ".mp3",
          ".wav",
          ".m4a",
          ".ogg",
          ".flac"
        ]
      }
    }
  ]
}